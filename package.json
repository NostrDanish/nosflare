{
  "name": "nosflare",
  "version": "8.9.28",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=worker.js --platform=neutral --target=es2020 --format=esm --minify=false --keep-names --external:node:*",
    "dev": "wrangler dev",
    "deploy": "npm run deploy:staging",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/nostr-protocol.test.ts --bundle --platform=node --format=esm --external:node:* --outfile=/tmp/nosflare-protocol.test.mjs && node --test /tmp/nosflare-protocol.test.mjs",
    "deploy:staging": "npm run build && wrangler deploy",
    "deploy:production": "npm run build && wrangler deploy --config wrangler.production.toml",
    "smoke:staging": "node tests/staging-smoke.mjs",
    "smoke:staging:writes": "node tests/staging-write-smoke.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "esbuild": "^0.19.12",
    "wrangler": "^3.0.0",
    "typescript": "^5.9.3"
  }
}
